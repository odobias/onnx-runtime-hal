<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{6E8B1C2A-0002-4A00-9000-00000000C0DE}</ProjectGuid>
    <RootNamespace>WhisperNpuHalApp</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(WhisperHalRoot)msbuild\common.props" />
  <Import Project="$(WhisperHalRoot)msbuild\backend.ort.props" Condition="'$(EnableOrt)'=='true'" />
  <Import Project="$(WhisperHalRoot)msbuild\backend.intel.props" Condition="'$(EnableIntel)'=='true'" />
  <Import Project="$(WhisperHalRoot)msbuild\backend.amd.props" Condition="'$(EnableAmd)'=='true'" />
  <Import Project="$(WhisperHalRoot)msbuild\backend.qualcomm.props" Condition="'$(EnableQualcomm)'=='true'" />

  <ItemDefinitionGroup>
    <ClCompile>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="$(WhisperHalRoot)app\main.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhisperNpuHal.Core\WhisperNpuHal.Core.vcxproj">
      <Project>{6E8B1C2A-0001-4A00-9000-00000000C0DE}</Project>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- Copy OpenVINO + GenAI + TBB runtime DLLs and plugins.xml next to the exe so
       it runs without a configured PATH. -->
  <Target Name="CopyIntelRuntime" AfterTargets="Build" Condition="'$(EnableIntel)'=='true'">
    <ItemGroup>
      <IntelRuntime Include="$(OpenVINOBinDir)\*.dll" />
      <IntelRuntime Include="$(OpenVINOBinDir)\*.xml" />
      <IntelRuntime Include="$(OpenVINOTbbDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(IntelRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied Intel OpenVINO runtime to $(OutDir)" />
  </Target>

  <!-- One unified runtime-staging step for the ONNX Runtime backend and every
       execution provider bundled into this build. All entries are Exists()-gated,
       so a given build (e.g. ARM64 CPU+QNN) copies exactly the DLLs it has and
       silently skips EPs it wasn't built with. This is what makes the output
       folder a self-contained, one-binary-carries-everything package. -->
  <Target Name="CopyUnifiedRuntime" AfterTargets="Build"
          Condition="'$(EnableOrt)'=='true' or '$(EnableQualcomm)'=='true' or '$(EnableAmd)'=='true'">
    <ItemGroup>
      <!-- Core ONNX Runtime + DirectML (GPU) -->
      <UnifiedRuntime Include="$(OrtBinDir)\onnxruntime*.dll" Condition="'$(OrtBinDir)'!=''" />
      <UnifiedRuntime Include="$(OrtBinDir)\DirectML.dll" Condition="Exists('$(OrtBinDir)\DirectML.dll')" />
      <!-- Intel OpenVINO EP (NPU/GPU/CPU). The provider DLL loads openvino.dll +
           its plugins by colocation, so every openvino_*/tbb DLL and the plugin
           catalog must land next to the exe. Gated on EnableOvep. -->
      <UnifiedRuntime Include="$(OrtBinDir)\openvino*.dll" Condition="'$(EnableOvep)'=='true' and '$(OrtBinDir)'!=''" />
      <UnifiedRuntime Include="$(OrtBinDir)\tbb*.dll" Condition="'$(EnableOvep)'=='true' and '$(OrtBinDir)'!=''" />
      <UnifiedRuntime Include="$(OrtBinDir)\*.xml" Condition="'$(EnableOvep)'=='true' and '$(OrtBinDir)'!=''" />
      <!-- Qualcomm QNN plugin EP (Hexagon NPU). Wildcards capture the provider,
           every Qnn* backend/stub, the Hexagon DSP skeletons and their catalogs. -->
      <UnifiedRuntime Include="$(QnnEpDir)\onnxruntime_providers_qnn.dll" Condition="Exists('$(QnnEpDir)\onnxruntime_providers_qnn.dll')" />
      <UnifiedRuntime Include="$(QnnEpDir)\Qnn*.dll" Condition="Exists('$(QnnEpDir)')" />
      <UnifiedRuntime Include="$(QnnEpDir)\Genie.dll" Condition="Exists('$(QnnEpDir)\Genie.dll')" />
      <UnifiedRuntime Include="$(QnnEpDir)\*Skel.so" Condition="Exists('$(QnnEpDir)')" />
      <UnifiedRuntime Include="$(QnnEpDir)\*.cat" Condition="Exists('$(QnnEpDir)')" />
      <!-- AMD Ryzen AI VitisAI EP (XDNA NPU) -->
      <UnifiedRuntime Include="$(OrtAmdBinDir)\onnxruntime*.dll" Condition="'$(EnableAmd)'=='true' and '$(OrtAmdBinDir)'!=''" />
      <UnifiedRuntime Include="$(OrtAmdBinDir)\dyn_dispatch_core.dll" Condition="Exists('$(OrtAmdBinDir)\dyn_dispatch_core.dll')" />
      <UnifiedRuntime Include="$(OrtAmdBinDir)\dyn_bins.dll" Condition="Exists('$(OrtAmdBinDir)\dyn_bins.dll')" />
      <UnifiedRuntime Include="$(OrtAmdBinDir)\vaiml.dll" Condition="Exists('$(OrtAmdBinDir)\vaiml.dll')" />
      <UnifiedRuntime Include="$(OrtAmdBinDir)\aiecompiler_client.dll" Condition="Exists('$(OrtAmdBinDir)\aiecompiler_client.dll')" />
      <UnifiedRuntime Include="$(OrtAmdBinDir)\DirectML.dll" Condition="Exists('$(OrtAmdBinDir)\DirectML.dll')" />
      <UnifiedRuntime Include="$(OrtAmdBinDir)\z.dll" Condition="Exists('$(OrtAmdBinDir)\z.dll')" />
      <UnifiedRuntime Include="$(OrtAmdBinDir)\zstd.dll" Condition="Exists('$(OrtAmdBinDir)\zstd.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(UnifiedRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(UnifiedRuntime)' != ''" />
    <Message Importance="high" Text="Staged unified ONNX Runtime + EP runtime (%(UnifiedRuntime.Filename)%(UnifiedRuntime.Extension)) to $(OutDir)" Condition="'@(UnifiedRuntime)' != ''" />
  </Target>

  <!-- Bundle the one portable static ONNX model into models/ next to the exe so
       the build output is a self-contained package that runs from its own folder.
       Gated on the model being present; disable with /p:BundleModel=false. -->
  <Target Name="BundleModel" AfterTargets="Build"
          Condition="'$(BundleModel)'=='true' and Exists('$(BundledModelDir)')">
    <ItemGroup>
      <ModelPayload Include="$(BundledModelDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModelPayload)"
          DestinationFiles="@(ModelPayload->'$(OutDir)models\whisper-tiny-en-static-onnx\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Condition="'@(ModelPayload)' != ''" />
    <Message Importance="high" Text="Bundled static ONNX model -> $(OutDir)models\whisper-tiny-en-static-onnx" Condition="'@(ModelPayload)' != ''" />
  </Target>

  <!-- Bundle the AMD Ryzen AI (VitisAI) model into the package so an EnableAmd build
       runs the full AMD benchmark (the amd-native variant plus the unified `auto`
       path) from its own folder. The static ONNX model is already bundled by
       BundleModel; this adds the vendor model (with its vitisai_config_*.json). Gated
       on EnableAmd + presence; a checkout without it fetched simply skips (run
       .\scripts\get-amd-model.ps1 once before publishing). Disable with /p:BundleModel=false. -->
  <Target Name="BundleAmdModel" AfterTargets="Build"
          Condition="'$(BundleModel)'=='true' and '$(EnableAmd)'=='true' and Exists('$(WhisperHalRoot)models\whisper-tiny-amd')">
    <ItemGroup>
      <AmdModelPayload Include="$(WhisperHalRoot)models\whisper-tiny-amd\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AmdModelPayload)"
          DestinationFiles="@(AmdModelPayload->'$(OutDir)models\whisper-tiny-amd\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Condition="'@(AmdModelPayload)' != ''" />
    <Message Importance="high" Text="Bundled AMD VitisAI model -> $(OutDir)models\whisper-tiny-amd" Condition="'@(AmdModelPayload)' != ''" />
  </Target>

  <!-- Bundle the labeled eval set + sample audio next to the exe so the build output
       can run the CPU/GPU/NPU benchmark fully offline (no fetch step). Exists-gated
       and shares the BundleModel switch; a fresh checkout with no eval set yet simply
       skips it (run .\scripts\get-eval-set.ps1 once before publishing). -->
  <Target Name="BundleBenchmarkData" AfterTargets="Build" Condition="'$(BundleModel)'=='true'">
    <ItemGroup>
      <EvalPayload Include="$(WhisperHalRoot)models\eval\**\*" Condition="Exists('$(WhisperHalRoot)models\eval')" />
      <SampleAudio Include="$(WhisperHalRoot)models\jfk.wav" Condition="Exists('$(WhisperHalRoot)models\jfk.wav')" />
    </ItemGroup>
    <Copy SourceFiles="@(EvalPayload)"
          DestinationFiles="@(EvalPayload->'$(OutDir)models\eval\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Condition="'@(EvalPayload)' != ''" />
    <Copy SourceFiles="@(SampleAudio)" DestinationFolder="$(OutDir)models" SkipUnchangedFiles="true" Condition="'@(SampleAudio)' != ''" />
    <Message Importance="high" Text="Bundled eval set + sample audio -> $(OutDir)models" Condition="'@(EvalPayload)' != '' or '@(SampleAudio)' != ''" />
  </Target>

  <!-- App-local MSVC runtime (vcruntime140*, msvcp140*, concrt140) so the package runs
       on a machine without the VC++ redistributable installed. The Universal CRT
       (ucrtbase / api-ms-win-crt-*) is part of Windows 10+ and serviced by Windows
       Update, so it is never shipped. The VC++ runtime is NOT an OS component and is
       NOT serviced by Windows Update, hence we bake it in for a self-contained build.
       Sources the redist from $(VCToolsRedistDir) when set, else globs the desktop
       x64 CRT out of $(VCInstallDir)Redist (the numeric version folder; onecore and
       the empty v14x marker folder are excluded by the single-level wildcard). -->
  <Target Name="StageVcRuntime" AfterTargets="Build">
    <ItemGroup>
      <VcCrt Include="$(VCToolsRedistDir)$(Platform)\Microsoft.VC*.CRT\*.dll" Condition="'$(VCToolsRedistDir)'!=''" />
      <VcCrt Include="$(VCInstallDir)Redist\MSVC\*\$(Platform)\Microsoft.VC*.CRT\*.dll" Condition="'$(VCToolsRedistDir)'=='' and '$(VCInstallDir)'!=''" />
    </ItemGroup>
    <Copy SourceFiles="@(VcCrt)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(VcCrt)' != ''" />
    <Message Importance="high" Text="Staged app-local MSVC runtime (%(VcCrt.Filename)%(VcCrt.Extension)) -> $(OutDir)" Condition="'@(VcCrt)' != ''" />
    <Warning Text="StageVcRuntime: no VC++ redist DLLs found; package will rely on a system-installed VC++ runtime." Condition="'@(VcCrt)' == ''" />
  </Target>
</Project>

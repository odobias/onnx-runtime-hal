<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{6E8B1C2A-0002-4A00-9000-00000000C0DE}</ProjectGuid>
    <RootNamespace>WhisperNpuHalApp</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(WhisperHalRoot)msbuild\common.props" />
  <Import Project="$(WhisperHalRoot)msbuild\backend.ort.props" Condition="'$(EnableOrt)'=='true'" />
  <Import Project="$(WhisperHalRoot)msbuild\backend.intel.props" Condition="'$(EnableIntel)'=='true'" />
  <Import Project="$(WhisperHalRoot)msbuild\backend.amd.props" Condition="'$(EnableAmd)'=='true'" />
  <Import Project="$(WhisperHalRoot)msbuild\backend.qualcomm.props" Condition="'$(EnableQualcomm)'=='true'" />

  <ItemDefinitionGroup>
    <ClCompile>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="$(WhisperHalRoot)app\main.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhisperNpuHal.Core\WhisperNpuHal.Core.vcxproj">
      <Project>{6E8B1C2A-0001-4A00-9000-00000000C0DE}</Project>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- Copy OpenVINO + GenAI + TBB runtime DLLs and plugins.xml next to the exe so
       it runs without a configured PATH. -->
  <Target Name="CopyIntelRuntime" AfterTargets="Build" Condition="'$(EnableIntel)'=='true'">
    <ItemGroup>
      <IntelRuntime Include="$(OpenVINOBinDir)\*.dll" />
      <IntelRuntime Include="$(OpenVINOBinDir)\*.xml" />
      <IntelRuntime Include="$(OpenVINOTbbDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(IntelRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied Intel OpenVINO runtime to $(OutDir)" />
  </Target>

  <!-- Copy generic ONNX Runtime DLLs for the static ONNX backend. Extra provider DLLs
       are copied when present; plain CPU ORT installs may only have onnxruntime.dll. -->
  <Target Name="CopyOrtRuntime" AfterTargets="Build" Condition="'$(EnableOrt)'=='true'">
    <ItemGroup>
      <OrtRuntime Include="$(OrtBinDir)\onnxruntime*.dll" />
      <OrtRuntime Include="$(OrtBinDir)\DirectML.dll" Condition="Exists('$(OrtBinDir)\DirectML.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(OrtRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(OrtRuntime)' != ''" />
    <Message Importance="high" Text="Copied ONNX Runtime to $(OutDir)" Condition="'@(OrtRuntime)' != ''" />
  </Target>

  <!-- Copy RyzenAI / ONNX Runtime VitisAI EP runtime DLLs next to the exe so the
       AMD backend runs without an activated Python or conda environment. -->
  <!-- Copy ONNX Runtime + Plugin QNN EP runtime for the Qualcomm backend. -->
  <Target Name="CopyQualcommRuntime" AfterTargets="Build" Condition="'$(EnableQualcomm)'=='true'">
    <ItemGroup>
      <QualcommRuntime Include="$(OrtBinDir)\onnxruntime.dll" Condition="Exists('$(OrtBinDir)\onnxruntime.dll')" />
      <QualcommRuntime Include="$(OrtBinDir)\onnxruntime_providers_shared.dll" Condition="Exists('$(OrtBinDir)\onnxruntime_providers_shared.dll')" />
      <QualcommRuntime Include="$(QnnEpDir)\onnxruntime_providers_qnn.dll" Condition="Exists('$(QnnEpDir)\onnxruntime_providers_qnn.dll')" />
      <QualcommRuntime Include="$(QnnEpDir)\QnnHtp.dll" Condition="Exists('$(QnnEpDir)\QnnHtp.dll')" />
      <QualcommRuntime Include="$(QnnEpDir)\QnnHtpNetRunExtensions.dll" Condition="Exists('$(QnnEpDir)\QnnHtpNetRunExtensions.dll')" />
      <QualcommRuntime Include="$(QnnEpDir)\QnnSystem.dll" Condition="Exists('$(QnnEpDir)\QnnSystem.dll')" />
      <QualcommRuntime Include="$(QnnEpDir)\QnnIr.dll" Condition="Exists('$(QnnEpDir)\QnnIr.dll')" />
      <QualcommRuntime Include="$(QnnEpDir)\QnnCpu.dll" Condition="Exists('$(QnnEpDir)\QnnCpu.dll')" />
      <QualcommRuntime Include="$(QnnEpDir)\QnnGpu.dll" Condition="Exists('$(QnnEpDir)\QnnGpu.dll')" />
      <QualcommRuntime Include="$(QnnEpDir)\HtpPrepare.dll" Condition="Exists('$(QnnEpDir)\HtpPrepare.dll')" />
      <QualcommRuntime Include="$(QnnEpDir)\Genie.dll" Condition="Exists('$(QnnEpDir)\Genie.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(QualcommRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(QualcommRuntime)' != ''" />
    <Message Importance="high" Text="Copied Qualcomm QNN runtime to $(OutDir)" Condition="'@(QualcommRuntime)' != ''" />
  </Target>

  <Target Name="CopyAmdRuntime" AfterTargets="Build" Condition="'$(EnableAmd)'=='true'">
    <ItemGroup>
      <AmdRuntime Include="$(OrtAmdBinDir)\onnxruntime.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\onnxruntime_providers_shared.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\onnxruntime_providers_vitisai.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\onnxruntime_vitisai_ep.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\onnxruntime_vitis_ai_custom_ops.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\dyn_dispatch_core.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\dyn_bins.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\vaiml.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\aiecompiler_client.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\DirectML.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\z.dll" />
      <AmdRuntime Include="$(OrtAmdBinDir)\zstd.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AmdRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied AMD RyzenAI runtime to $(OutDir)" />
  </Target>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!-- AMD backend: ONNX Runtime + VitisAI EP (Ryzen AI). Imported only when
     EnableAmd=true. Point RyzenAiDir at your Ryzen AI SDK, e.g.
     /p:EnableAmd=true /p:RyzenAiDir=C:\Program Files\RyzenAI\1.8.0-beta -->
<Project>
  <PropertyGroup>
    <RyzenAiDir Condition="'$(RyzenAiDir)'=='' and '$(RYZEN_AI_INSTALLATION_PATH)'!=''">$(RYZEN_AI_INSTALLATION_PATH)</RyzenAiDir>
    <RyzenAiDir Condition="'$(RyzenAiDir)'==''">C:\Program Files\RyzenAI\1.8.0-beta</RyzenAiDir>
    <OrtAmdDir Condition="'$(OrtAmdDir)'==''">$(RyzenAiDir)\onnxruntime</OrtAmdDir>
    <OrtAmdInclude Condition="'$(OrtAmdInclude)'==''">$(OrtAmdDir)\include\onnxruntime\core\session</OrtAmdInclude>
    <OrtAmdLibDir Condition="'$(OrtAmdLibDir)'==''">$(OrtAmdDir)\lib</OrtAmdLibDir>
    <OrtAmdBinDir Condition="'$(OrtAmdBinDir)'==''">$(OrtAmdDir)\bin</OrtAmdBinDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(OrtAmdInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NPU_INFERENCE_BENCH_AMD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(OrtAmdLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>onnxruntime.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>

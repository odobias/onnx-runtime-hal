<?xml version="1.0" encoding="utf-8"?>
<!-- Shared C++ settings + output layout for all projects. -->
<Project>
  <PropertyGroup>
    <!-- OVEP ships openvino 2025.4.1 DLLs; the Intel GenAI build ships openvino
         2026.x. They must never share an output folder, so the OVEP variant gets
         its own "<platform>-ovep" tree (exe + colocated runtime + obj). -->
    <PlatformOutTag Condition="'$(EnableOvep)'=='true'">$(Platform)-ovep</PlatformOutTag>
    <PlatformOutTag Condition="'$(PlatformOutTag)'==''">$(Platform)</PlatformOutTag>
    <OutDir>$(NpuInferenceBenchRoot)build\$(PlatformOutTag)\$(Configuration)\</OutDir>
    <IntDir>$(NpuInferenceBenchRoot)build\obj\$(MSBuildProjectName)\$(PlatformOutTag)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <SDLCheck>true</SDLCheck>
      <AdditionalIncludeDirectories>$(NpuInferenceBenchRoot)runner\include;$(NpuInferenceBenchRoot)runner\runtime;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>

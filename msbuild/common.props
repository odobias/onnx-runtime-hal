<?xml version="1.0" encoding="utf-8"?>
<!-- Shared C++ settings + output layout for all projects. -->
<Project>
  <PropertyGroup>
    <OutDir>$(WhisperHalRoot)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(WhisperHalRoot)build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <SDLCheck>true</SDLCheck>
      <AdditionalIncludeDirectories>$(WhisperHalRoot)include;$(WhisperHalRoot)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>

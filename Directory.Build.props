<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-wide defaults, auto-imported by every project. Override on the MSBuild
     command line, e.g. /p:EnableAmd=true /p:OpenVINODir=C:\sdk\openvino_genai -->
<Project>
  <PropertyGroup>
    <WhisperHalRoot>$(MSBuildThisFileDirectory)</WhisperHalRoot>

    <!-- OpenVINO GenAI C++ SDK location (Intel backend). Priority:
         explicit /p:OpenVINODir  >  OPENVINO_GENAI_DIR env  >  bundled third_party -->
    <OpenVINODir Condition="'$(OpenVINODir)'=='' and '$(OPENVINO_GENAI_DIR)'!=''">$(OPENVINO_GENAI_DIR)</OpenVINODir>
    <OpenVINODir Condition="'$(OpenVINODir)'==''">$(WhisperHalRoot)third_party\openvino_genai</OpenVINODir>

    <!-- Per-backend build toggles. Intel is the working reference (on by default);
         AMD/Qualcomm compile as throwing stubs unless their SDKs are wired in. -->
    <EnableIntel Condition="'$(EnableIntel)'==''">true</EnableIntel>
    <EnableAmd Condition="'$(EnableAmd)'==''">false</EnableAmd>
    <EnableQualcomm Condition="'$(EnableQualcomm)'==''">false</EnableQualcomm>
  </PropertyGroup>
</Project>

{
  "schema_version": 1,
  "suite": "portable",
  "description": "Portable inference benchmark workloads and supported executor classes.",
  "workloads": [
    {
      "id": "whisper-tiny-static",
      "kind": "asr",
      "backend": "onnx-static",
      "path": "workloads/whisper/models/static-onnx",
      "executionProfiles": [
        {
          "id": "static-onnx",
          "devices": ["npu", "gpu", "cpu"],
          "graphRole": "whole",
          "referenceContract": "whisper-eval-v1"
        }
      ],
      "devices": ["npu", "gpu", "cpu"],
      "metrics": ["latency", "rtf", "wer", "cer", "cpu_offload"]
    },
    {
      "id": "whisper-tiny-dynamic",
      "kind": "asr",
      "backend": "onnx-dynamic",
      "path": "workloads/whisper/models/dynamic-onnx",
      "executionProfiles": [
        {
          "id": "dynamic-kv-onnx",
          "devices": ["gpu", "cpu"],
          "graphRole": "whole",
          "referenceContract": "whisper-eval-v1"
        }
      ],
      "devices": ["gpu", "cpu"],
      "metrics": ["latency", "rtf", "wer", "cer", "cpu_offload"]
    },
    {
      "id": "tsc",
      "kind": "classifier",
      "backend": "onnx-fixture",
      "path": "models/deepfake/fixtures/tsc",
      "executionProfiles": [
        {
          "id": "whole-fp32",
          "devices": ["npu", "gpu", "cpu"],
          "graphRole": "whole",
          "referenceContract": "full-model-cpu-fp32"
        }
      ],
      "devices": ["npu", "gpu", "cpu"],
      "metrics": ["latency", "accuracy", "reference_drift", "cpu_offload"]
    },
    {
      "id": "fakeaudio",
      "kind": "classifier",
      "backend": "onnx-fixture",
      "path": "models/deepfake/fixtures/fakeaudio",
      "executionProfiles": [
        {
          "id": "whole-fp32",
          "devices": ["cpu", "gpu"],
          "path": "models/deepfake/fixtures/fakeaudio",
          "graphRole": "whole",
          "referenceContract": "full-model-cpu-fp32",
          "accuracyEligible": true
        },
        {
          "id": "npu-split-intel",
          "devices": ["npu"],
          "hostVendors": ["Intel"],
          "path": "models/deepfake/fixtures/fakeaudio-bb-expanded-attention-bias",
          "graphRole": "backbone",
          "frontendContract": "cpu-fp32-logmel",
          "referenceContract": "full-model-cpu-fp32",
          "accuracyEligible": true,
          "outputs": [
            "models/deepfake/fakeaudio/model.backbone.expanded-attention-bias.onnx",
            "models/deepfake/fixtures/fakeaudio-bb-expanded-attention-bias/model.tsv",
            "models/deepfake/fixtures/fakeaudio-bb-expanded-attention-bias/fixture-step.json"
          ],
          "steps": [
            {
              "script": "tools/research/export_fakeaudio_variants.py",
              "arguments": ["--skip-int8"]
            },
            {
              "script": "tools/research/build_fakeaudio_variant_fixtures.py",
              "arguments": ["--only", "intel-npu"]
            }
          ]
        },
        {
          "id": "npu-split-generic",
          "devices": ["npu"],
          "hostVendors": ["AMD", "Qualcomm"],
          "path": "models/deepfake/fixtures/fakeaudio-bb-fp32",
          "graphRole": "backbone",
          "frontendContract": "cpu-fp32-logmel",
          "referenceContract": "full-model-cpu-fp32",
          "accuracyEligible": true,
          "outputs": [
            "models/deepfake/fakeaudio/model.backbone-fp32.onnx",
            "models/deepfake/fixtures/fakeaudio-bb-fp32/model.tsv"
          ],
          "steps": [
            {
              "script": "tools/research/export_fakeaudio_variants.py",
              "arguments": ["--skip-int8"]
            },
            {
              "script": "tools/research/build_fakeaudio_variant_fixtures.py",
              "arguments": ["--only", "generic-npu"]
            }
          ]
        },
        {
          "id": "npu-whole-diagnostic",
          "devices": ["npu"],
          "path": "models/deepfake/fixtures/fakeaudio",
          "graphRole": "whole",
          "referenceContract": "full-model-cpu-fp32",
          "accuracyEligible": false,
          "default": false
        }
      ],
      "devices": ["npu", "gpu", "cpu"],
      "metrics": ["latency", "accuracy", "reference_drift", "cpu_offload"]
    }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Shared C++ settings + output layout for all projects. -->
<Project>
  <PropertyGroup>
    <!-- OVEP ships openvino 2025.4.1 DLLs; the Intel GenAI build ships openvino
         2026.x. They must never share an output folder, so the OVEP variant gets
         its own "<platform>-ovep" tree (exe + colocated runtime + obj). -->
    <PlatformOutTag Condition="'$(EnableOvep)'=='true'">$(Platform)-ovep</PlatformOutTag>
    <PlatformOutTag Condition="'$(EnableWinML)'=='true'">$(Platform)-winml</PlatformOutTag>
    <PlatformOutTag Condition="'$(EnableAmd)'=='true'">$(Platform)-amd</PlatformOutTag>
    <PlatformOutTag Condition="'$(EnableQualcomm)'=='true'">$(Platform)-qualcomm</PlatformOutTag>
    <PlatformOutTag Condition="'$(PlatformOutTag)'==''">$(Platform)</PlatformOutTag>
    <OutDir>$(ArtifactsRoot)build\$(PlatformOutTag)\$(Configuration)\</OutDir>
    <IntDir>$(ArtifactsRoot)build\obj\$(MSBuildProjectName)\$(PlatformOutTag)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- VS2022 maps stdcpp23 -> /std:c++23preview (ISO C++23 on MSVC 19.4x). -->
      <LanguageStandard>stdcpp23</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <SDLCheck>true</SDLCheck>
      <AdditionalIncludeDirectories>$(NpuInferenceBenchRoot)src\runner\include;$(NpuInferenceBenchRoot)src\runner\runtime;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Keep __cplusplus honest so feature-test macros match the selected standard. -->
      <AdditionalOptions>/Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{6E8B1C2A-0002-4A00-9000-00000000C0DE}</ProjectGuid>
    <RootNamespace>NpuInferenceBenchApp</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <TargetName>NpuInferenceBench</TargetName>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(NpuInferenceBenchRoot)eng\msbuild\common.props" />
  <Import Project="$(NpuInferenceBenchRoot)eng\msbuild\backend.winml.props" Condition="'$(EnableWinML)'=='true'" />
  <Import Project="$(NpuInferenceBenchRoot)eng\msbuild\backend.ort.props" Condition="'$(EnableOrt)'=='true' and '$(EnableWinML)'!='true'" />
  <Import Project="$(NpuInferenceBenchRoot)eng\msbuild\backend.intel.props" Condition="'$(EnableIntel)'=='true'" />
  <Import Project="$(NpuInferenceBenchRoot)eng\msbuild\backend.amd.props" Condition="'$(EnableAmd)'=='true'" />
  <Import Project="$(NpuInferenceBenchRoot)eng\msbuild\backend.qualcomm.props" Condition="'$(EnableQualcomm)'=='true'" />

  <ItemDefinitionGroup>
    <ClCompile>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="$(NpuInferenceBenchRoot)src\runner\cli\main.cpp" />
    <ClCompile Include="$(NpuInferenceBenchRoot)src\runner\cli\generic_onnx_cli.cpp" />
    <ClCompile Include="$(NpuInferenceBenchRoot)src\runner\benchmark\benchmark_runner.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(NpuInferenceBenchRoot)src\runner\include\npu_inference_bench\benchmark_runner.hpp" />
    <ClInclude Include="$(NpuInferenceBenchRoot)src\runner\include\npu_inference_bench\generic_onnx_cli.hpp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NpuInferenceBench.Core\NpuInferenceBench.Core.vcxproj">
      <Project>{6E8B1C2A-0001-4A00-9000-00000000C0DE}</Project>
    </ProjectReference>
    <ProjectReference Include="..\OnnxRuntimeHal\OnnxRuntimeHal.vcxproj">
      <Project>{6E8B1C2A-0003-4A00-9000-00000000C0DE}</Project>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(NpuInferenceBenchRoot)eng\msbuild\runtime-pack.targets" />

  <!-- Copy OpenVINO + GenAI + TBB runtime DLLs and plugins.xml next to the exe so
       it runs without a configured PATH. -->
  <Target Name="CopyIntelRuntime" AfterTargets="Build" Condition="'$(EnableIntel)'=='true'">
    <ItemGroup>
      <IntelRuntime Include="$(OpenVINOBinDir)\*.dll" />
      <IntelRuntime Include="$(OpenVINOBinDir)\*.xml" />
      <IntelRuntime Include="$(OpenVINOTbbDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(IntelRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied Intel OpenVINO runtime to $(OutDir)" />
  </Target>

  <!-- Bundle the one portable static ONNX model into models/ next to the exe so
       the build output is a self-contained package that runs from its own folder.
       Gated on the model being present; disable with /p:BundleModel=false. -->
  <Target Name="BundleModel" AfterTargets="Build"
          Condition="'$(BundleModel)'=='true' and Exists('$(BundledModelDir)')">
    <ItemGroup>
      <ModelPayload Include="$(BundledModelDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModelPayload)"
          DestinationFiles="@(ModelPayload->'$(OutDir)artifacts\workloads\whisper\models\static-onnx\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Condition="'@(ModelPayload)' != ''" />
    <Message Importance="high" Text="Bundled static ONNX model -> $(OutDir)artifacts\workloads\whisper\models\static-onnx" Condition="'@(ModelPayload)' != ''" />
  </Target>

  <!-- Optionally bundle the AMD Ryzen AI (VitisAI) model so an EnableAmd build can
       also run the amd-native benchmark variant offline. The unified auto/onnx-static
       path does NOT need this (it runs the portable static model), so it is opt-in:
       off by default, enable with /p:BundleAmdModel=true. Also Exists-gated on the
       model being fetched (run .\tools\fetch\get-amd-model.ps1 once before publishing). -->
  <Target Name="BundleAmdModel" AfterTargets="Build"
          Condition="'$(BundleAmdModel)'=='true' and '$(EnableAmd)'=='true' and Exists('$(NpuInferenceBenchRoot)artifacts\workloads\whisper\models\vendor\amd')">
    <ItemGroup>
      <AmdModelPayload Include="$(NpuInferenceBenchRoot)artifacts\workloads\whisper\models\vendor\amd\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AmdModelPayload)"
          DestinationFiles="@(AmdModelPayload->'$(OutDir)artifacts\workloads\whisper\models\vendor\amd\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Condition="'@(AmdModelPayload)' != ''" />
    <Message Importance="high" Text="Bundled AMD VitisAI model -> $(OutDir)artifacts\workloads\whisper\models\vendor\amd" Condition="'@(AmdModelPayload)' != ''" />
  </Target>

  <!-- Bundle ASR speech samples next to the exe so the build output can run the
       CPU/GPU/NPU benchmark fully offline (no fetch step). Exists-gated and shares
       the BundleModel switch; a fresh checkout with no speech tree yet simply skips
       it (run .\tools\fetch\get-eval-set.ps1 / get-models.ps1 once before publishing). -->
  <Target Name="BundleBenchmarkData" AfterTargets="Build" Condition="'$(BundleModel)'=='true'">
    <ItemGroup>
      <SpeechPayload Include="$(NpuInferenceBenchRoot)artifacts\workloads\speech\**\*" Condition="Exists('$(NpuInferenceBenchRoot)artifacts\workloads\speech')" />
    </ItemGroup>
    <Copy SourceFiles="@(SpeechPayload)"
          DestinationFiles="@(SpeechPayload->'$(OutDir)artifacts\workloads\speech\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Condition="'@(SpeechPayload)' != ''" />
    <Message Importance="high" Text="Bundled speech samples -> $(OutDir)artifacts\workloads\speech" Condition="'@(SpeechPayload)' != ''" />
  </Target>

  <!-- App-local MSVC runtime (vcruntime140*, msvcp140*, concrt140) so the package runs
       on a machine without the VC++ redistributable installed. The Universal CRT
       (ucrtbase / api-ms-win-crt-*) is part of Windows 10+ and serviced by Windows
       Update, so it is never shipped. The VC++ runtime is NOT an OS component and is
       NOT serviced by Windows Update, hence we bake it in for a self-contained build.
       Sources the redist from $(VCToolsRedistDir) when set, else globs the desktop
       x64 CRT out of $(VCInstallDir)Redist (the numeric version folder; onecore and
       the empty v14x marker folder are excluded by the single-level wildcard). -->
  <Target Name="StageVcRuntime" AfterTargets="Build">
    <ItemGroup>
      <VcCrt Include="$(VCToolsRedistDir)$(Platform)\Microsoft.VC*.CRT\*.dll" Condition="'$(VCToolsRedistDir)'!=''" />
      <VcCrt Include="$(VCInstallDir)Redist\MSVC\*\$(Platform)\Microsoft.VC*.CRT\*.dll" Condition="'$(VCToolsRedistDir)'=='' and '$(VCInstallDir)'!=''" />
    </ItemGroup>
    <Copy SourceFiles="@(VcCrt)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(VcCrt)' != ''" />
    <Message Importance="high" Text="Staged app-local MSVC runtime (%(VcCrt.Filename)%(VcCrt.Extension)) -> $(OutDir)" Condition="'@(VcCrt)' != ''" />
    <Warning Text="StageVcRuntime: no VC++ redist DLLs found; package will rely on a system-installed VC++ runtime." Condition="'@(VcCrt)' == ''" />
  </Target>
</Project>

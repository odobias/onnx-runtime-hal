# Build output (root only — do not swallow tools/build/*.ps1)
/build/
/dist/
bin/
obj/

# Downloaded / linked SDKs (large; fetched by tools/setup/)
third_party/

# Python virtual env (created by tools/fetch/get-whisper-model.ps1)
.venv/
.venv-ovep/
.venv-quark*/
__pycache__/

# Workload payloads (fetched/exported by tools; never committed)
workloads/whisper/models/
workloads/whisper/manifest*.json
workloads/classifiers/tsc/
workloads/classifiers/fakeaudio/
workloads/classifiers/audio-samples/
workloads/classifiers/fixtures/
# Eval WAVs stay local/fetched; bake baselines into the tracked manifest.
workloads/eval/*
!workloads/eval/eval.jsonl
workloads/audio/
# Legacy/non-runtime cache only (do not use as suite asset root).
# Classifier runtime lives under workloads/classifiers/.
/models/
*.wav
*.blob
*_openvino_model/
*-ov/

# Compiled-model cache
cache/
original-info-signature.txt
original-model-signature.txt

# Regenerated benchmark report artifacts (overwritten by benchmark/research/sweep-quantization.ps1 each
# run; the canonical CSV ledgers under results/ledgers/ are tracked).
results/quantization-benchmark.csv
results/quantization-benchmark-detail.csv
results/quantization-benchmark.md
results/host-info.json
# Rolling local state; completed runs publish results/run-attempts/<snapshot>.jsonl.
results/ledgers/attempts.jsonl
results/*-here.csv

# Transient build/benchmark logs (e.g. build_ovep.log, bench_intel_whisper.log)
*.log

# Visual Studio
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb

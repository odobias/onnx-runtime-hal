# while the remaining model families migrate to workloads/.
/models/
*.wav
*.blob
*_openvino_model/
*-ov/

# Compiled-model cache
cache/
original-info-signature.txt
original-model-signature.txt

# Regenerated benchmark report artifacts (overwritten by benchmark/research/sweep-quantization.ps1 each

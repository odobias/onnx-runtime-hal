# Build output
build/
bin/
obj/

# Downloaded / linked SDKs (large; fetched by scripts/setup-intel.ps1)
third_party/

# Python virtual env (created by scripts/get-model.ps1)
.venv/
.venv-ovep/
__pycache__/

# Models & audio (fetched/exported by scripts; never committed)
models/
*.wav
*.blob
*_openvino_model/
*-ov/

# Compiled-model cache
cache/
original-info-signature.txt
original-model-signature.txt

# Regenerated benchmark report artifacts (overwritten by scripts/benchmark-quant.ps1 each
# run; the canonical ledger is results/benchmark-results.csv, which IS tracked).
results/quantization-benchmark.csv
results/quantization-benchmark-detail.csv
results/quantization-benchmark.md
results/host-info.json

# Transient build/benchmark logs (e.g. build_ovep.log, bench_intel_whisper.log)
*.log

# Visual Studio
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb

# Everything under artifacts/ is generated/local-only, except the folder contract.
/artifacts/**
!/artifacts/README.md
!/artifacts/scratch/
!/artifacts/scratch/.gitkeep

# Legacy roots (pre-artifacts/ consolidation). Keep ignoring if present locally.
/build/
/dist/
/third_party/
/cache/
/.venv/
/.venv-ovep/
/.venv-quark*/
/models/
bin/
obj/

# Python
__pycache__/

# Workload binary noise if someone regenerates beside source trees
*.wav
*.blob
*_openvino_model/
*-ov/
original-info-signature.txt
original-model-signature.txt

# Rolling local state; completed runs publish results/run-attempts/<snapshot>.jsonl.
results/ledgers/attempts.jsonl

# Transient build/benchmark logs
*.log

# Visual Studio
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
